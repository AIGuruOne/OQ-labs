# Copy this file to the repo root as `.env` and fill in the values.
#   cp setup/.env.example .env
# `.env` is git-ignored. Never commit a real key.

# ---- Hosted API (required for the labs that call a hosted model) ----
# Your API key for the hosted OpenAI-compatible endpoint.
OPENAI_API_KEY=

# Base URL of the hosted endpoint. Leave the default unless told otherwise.
HOSTED_BASE_URL=https://api.openai.com/v1

# Model name to use on the hosted endpoint.
HOSTED_MODEL=gpt-4o-mini

# ---- Local Ollama (Day 2; installed in-notebook on Colab) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ---- Tuned adapter (exists after the Day 2 fine-tune lab) ----
# The name the tuned model is registered under in Ollama.
TUNED_MODEL=oq-ticket-tuned

# ---- Default endpoint for config/endpoints.py ----
# One of: local | hosted | tuned
LLM_ENDPOINT=hosted

# ---- Mock ERP (Day 4 agent labs, Day 5 S26 MCP server) ----
# Where the mock ERP answers. uvicorn's default port; the notebooks start it there.
MOCK_ERP_URL=http://127.0.0.1:8000
# Leave EMPTY for the labs (no key needed). Set it to any string to make the ERP
# demand the header X-API-Key: <that string>. A lab secret, not production auth.
MOCK_ERP_API_KEY=

# ---- Reference MCP server (Day 5 S26; services/mcp_server_reference/) ----
# Where clients (python -m services.mcp_server_reference.call) find the server.
MCP_SERVER_URL=http://127.0.0.1:8100/mcp
# Who may approve raise_work_order, comma-separated (governance template 4.4).
OQ_MCP_APPROVERS=planner:salim,planner:aisha,planner:nasser
# Secret. EMPTY for the lab: a fresh key at every start, so a restart forgets
# pending approvals. Set it (32+ random characters) to keep them across restarts.
OQ_MCP_STATE_KEY=
