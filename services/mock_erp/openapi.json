   "post": {
    "tags": [
     "Work orders"
    ],
    "summary": "Raise a work order and release it to the site crew (THE ONE WRITE)",
    "description": "**Consequential and not reversible through this API.** The new work\norder is created in status `released`: it is on the site crew's list\nthe moment this returns, and priority 1 calls a crew out now. There is\nno endpoint to edit, cancel or delete it.\n\nCall it only after a named person has approved the exact body you are\nabout to send, and put that person in `approved_by`.\n\n- `201 Created`: the new work order; its URL is in the `Location` header.\n- `409 Conflict`: `source_ticket` already has a work order (a retry after a\n  timeout lands here instead of raising a duplicate).\n- `422`: a field is wrong, or the tag is not in the equipment master.\n  Nothing was written.",
    "operationId": "raise_work_order_work_orders_post",
    "security": [
     {
      "APIKeyHeader": []
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/WorkOrderCreate"
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/WorkOrder"
        }
       }
      }
     },
     "401": {
      "description": "Only when MOCK_ERP_API_KEY is set: key missing or wrong.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      }
     },
     "400": {
      "description": "The body is not valid JSON.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      }
     },
     "409": {
      "description": "This source ticket already has a work order.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      }
     },
     "415": {
      "description": "The body was not sent as application/json.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      }
     },
     "422": {
      "description": "A parameter or field is wrong. `problems` says which.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      }
     }
    }
   }
  },
