     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/EquipmentPage"
        }
       }
      }
     },
     "401": {
      "description": "Only when MOCK_ERP_API_KEY is set: key missing or wrong.",
