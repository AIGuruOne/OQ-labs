   "WorkOrderCreate": {
    "properties": {
     "equipment_tag": {
      "type": "string",
      "pattern": "^[A-Z]{1,3}-[0-9]{4}[A-Z]?$",
      "title": "Equipment Tag",
      "description": "Must be a tag in the equipment master (GET /equipment/{tag})."
     },
     "work_type": {
      "type": "string",
      "enum": [
       "corrective",
       "preventive",
       "inspection"
      ],
      "title": "Work Type"
     },
     "priority": {
      "type": "integer",
      "enum": [
       1,
       2,
       3,
       4
      ],
      "title": "Priority",
      "description": "1 emergency: the site crew is called out NOW. 2 urgent: within 2 days. 3 normal: within 7 days. 4 planned: next maintenance window."
     },
     "title": {
      "type": "string",
      "maxLength": 80,
      "minLength": 5,
      "title": "Title"
     },
     "description": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 10,
      "title": "Description"
     },
     "requested_by": {
      "type": "string",
      "maxLength": 80,
      "minLength": 2,
      "title": "Requested By",
      "description": "Who asked for the work."
     },
     "approved_by": {
      "type": "string",
      "maxLength": 80,
      "minLength": 2,
      "title": "Approved By",
      "description": "The PERSON who approved raising this work order. Required. The ERP records it; it cannot check it. The check happens before this call: the agent's approval interrupt and the MCP server's gate."
     },
     "source_ticket": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^INC-[0-9]{6}$"
       },
       {
        "type": "null"
       }
      ],
      "title": "Source Ticket",
      "description": "Service desk ticket this came from. One work order per ticket: a second POST with the same ticket gets 409 Conflict."
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "equipment_tag",
     "work_type",
     "priority",
     "title",
     "description",
     "requested_by",
     "approved_by"
    ],
    "title": "WorkOrderCreate",
    "description": "The body of POST /work-orders. Unknown fields are refused, so a typo\nsuch as `prority` is an error, not a silently ignored field.",
    "examples": [
     {
      "approved_by": "Salim (maintenance planner, MRB)",
      "description": "Control room reports P-1201A screen red and the pump sounds wrong. Seal replaced under WO-118305 in May 2026. Inspect seal and bearings.",
      "equipment_tag": "P-1201A",
      "priority": 2,
      "requested_by": "Control room operator, MRB",
      "source_ticket": "INC-004412",
      "title": "P-1201A abnormal noise, suspect seal",
      "work_type": "corrective"
     }
    ]
