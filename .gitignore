# Secrets — never committed. .env.example is the committed template.
.env

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
.venv-finetune/
venv/
*.egg-info/

# Notebooks
.ipynb_checkpoints/

# Model checkpoints: ignore everything EXCEPT the pre-baked adapter,
# which ships in the repo so Day 2 S12 and Day 4 S19 work even if
# nobody's training run completes.
checkpoints/*
!checkpoints/adapter_prebaked/
!checkpoints/adapter_prebaked/**

# Eval harness output (scripts/run_eval.py default --out). The reference
# runs we DO keep live in facilitator/prebaked_outputs/eval/.
eval_runs/

# The file each group types in Day 5 S26 (facilitator/mcp_build_sequence.md)
s26_server.py

# Local tool state (not lab material)
.claude/settings.local.json
.kilo/

# OS noise
.DS_Store
Thumbs.db

# Day 3 / Day 4 lab output. These notebooks build their own working set —
# rendered images, a chunk index, two MCP servers, saved runs — from the
# payload cells inside them, so nothing here is source. The reference
# copies we DO keep live in facilitator/ and facilitator/prebaked_outputs/.
artifacts/
corpus/images/*.png
corpus/images/*.json
data/eval/image_ground_truth/*.json
notebooks/corpus/
notebooks/artifacts/
s23_agent_graph/
s24_agent_control/
mcp_live/
notebooks/s23_agent_graph/
notebooks/s24_agent_control/
notebooks/mcp_live/
notebooks/harness_and_loop_handout.md

# Lab 11a writes an audit log while it runs
outputs/11a/
